{
  "name": "web-llm-adapters",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:unused": "knip",
    "check:packages": "npm run check:package --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run build && npm run typecheck && npm run test:coverage && npm run check:unused && npm run check:packages",
    "test:extensions": "node examples/strands-web-llm/browser/scripts/setup-extension.ts && playwright test --config playwright.extension.config.ts",
    "test:install": "npm run test:install --workspaces --if-present",
    "check:release": "npm run check && npm run test:install && npm run test:browser && npm run test:extensions",
    "dev:strands": "npm run build --workspace strands-web-llm && npm run dev --workspace @web-llm-adapters/strands-browser",
    "preview:strands": "npm run preview --workspace @web-llm-adapters/strands-browser"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@strands-agents/sdk": "1.21.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
