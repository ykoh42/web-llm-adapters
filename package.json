{
  "name": "web-llm-adapters",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "build:adapters": "pnpm --filter \"./packages/*\" run build",
    "build:strands:browser": "pnpm --filter \"@web-llm-adapters/strands-browser...\" run build",
    "test": "pnpm build:adapters && vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "pnpm build:adapters && vitest run --coverage",
    "test:browser": "pnpm build:strands:browser && pnpm test:browser:built",
    "test:browser:built": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:unused": "knip",
    "check:packages": "pnpm -r run check:package",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm check:startup && pnpm typecheck && vitest run --coverage && pnpm test:standard && pnpm check:unused && pnpm check:packages",
    "check:startup": "node scripts/check-startup.mjs",
    "test:extensions": "pnpm build:strands:browser && pnpm test:extensions:built",
    "test:extensions:built": "node examples/strands-web-llm/browser/scripts/setup-extension.ts && playwright test --config playwright.extension.config.ts",
    "test:install": "pnpm -r --workspace-concurrency=1 run test:install",
    "test:install:manager": "pnpm --filter \"./packages/*\" --workspace-concurrency=1 run test:install",
    "check:release": "pnpm check && pnpm test:install && pnpm test:browser:built && pnpm test:extensions:built && pnpm test:langchain:built && pnpm test:pi:built",
    "dev:strands": "pnpm --filter strands-web-llm build && pnpm --filter @web-llm-adapters/strands-browser dev",
    "preview:strands": "pnpm --filter @web-llm-adapters/strands-browser preview",
    "test:standard": "pnpm --filter langchain-web-llm test:standard",
    "test:langchain": "pnpm --filter \"@web-llm-adapters/langchain-browser...\" run build && pnpm test:langchain:built",
    "test:langchain:built": "playwright test --config playwright.langchain.config.ts",
    "dev:langchain": "pnpm --filter langchain-web-llm build && pnpm --filter @web-llm-adapters/langchain-browser dev",
    "test:langchain:standard": "node packages/langchain-web-llm/scripts/standard.ts && REAL_MODELS=1 vitest run --config vitest.standard.config.ts",
    "check:release:langchain": "pnpm check && pnpm --filter langchain-web-llm test:install && playwright test --config playwright.langchain.config.ts && pnpm test:langchain:standard",
    "dev:pi": "pnpm --filter pi-ai-web-llm build && pnpm --filter @web-llm-adapters/pi-ai-browser dev",
    "test:pi": "pnpm --filter \"@web-llm-adapters/pi-ai-browser...\" run build && pnpm test:pi:built",
    "test:pi:built": "playwright test --config playwright.pi.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "1.3.0",
    "@playwright/test": "^1.64.1",
    "@strands-agents/sdk": "1.22.0",
    "@types/chrome": "^0.3.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "knip": "^6.42.1",
    "langchain": "1.5.19",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@mlc-ai/web-llm": "0.2.86",
    "langchain-web-llm": "workspace:*",
    "pi-ai-web-llm": "workspace:*",
    "strands-web-llm": "workspace:*",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.15.0"
}
