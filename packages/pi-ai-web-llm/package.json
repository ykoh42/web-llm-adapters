{
  "name": "pi-ai-web-llm",
  "version": "0.2.0",
  "description": "Browser-local WebLLM providers for Pi AI and Pi Agent Core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/web-llm-adapters.git",
    "directory": "packages/pi-ai-web-llm"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/gemma-4-e2b.wasm": "./dist/runtime/gemma-4-e2b.wasm",
    "./runtime/manifest.json": "./dist/runtime/manifest.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./runtime/gemma-4-e2b.wasm",
    "prepack": "tsdown --logLevel error",
    "test:install": "node test/install.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "~1.4.0",
    "@mlc-ai/web-llm": "~0.2.86"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@mlc-ai/web-llm": "0.2.86"
  }
}
