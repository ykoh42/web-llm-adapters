{
  "name": "strands-web-llm",
  "version": "0.2.0",
  "description": "WebLLM model provider for Strands Agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/web-llm-adapters.git",
    "directory": "packages/strands-web-llm"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime/gemma-4-e2b.wasm": "./dist/runtime/gemma-4-e2b.wasm",
    "./runtime/manifest.json": "./dist/runtime/manifest.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./runtime/gemma-4-e2b.wasm",
    "test:install": "node test/install.ts",
    "prepack": "tsdown --logLevel error"
  },
  "peerDependencies": {
    "@mlc-ai/web-llm": "~0.2.86",
    "@strands-agents/sdk": "~1.22.0"
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "@strands-agents/sdk": "1.22.0"
  },
  "license": "MIT"
}
