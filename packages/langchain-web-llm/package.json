{
  "name": "langchain-web-llm",
  "version": "0.4.1",
  "description": "WebLLM chat models and embeddings for LangChain, LangGraph, and Deep Agents.",
  "keywords": [
    "langchain",
    "langgraph",
    "deepagents",
    "web-llm",
    "webllm",
    "webgpu",
    "browser",
    "llm",
    "embeddings"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/web-llm-adapters.git",
    "directory": "packages/langchain-web-llm"
  },
  "bugs": {
    "url": "https://github.com/ykoh42/web-llm-adapters/issues"
  },
  "homepage": "https://github.com/ykoh42/web-llm-adapters/tree/main/packages/langchain-web-llm#readme",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime/gemma-4-e2b.wasm": "./dist/runtime/gemma-4-e2b.wasm",
    "./runtime/manifest.json": "./dist/runtime/manifest.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack --profile esm-only --exclude-entrypoints ./runtime/gemma-4-e2b.wasm",
    "prepack": "tsdown --logLevel error",
    "test:standard": "node scripts/standard.ts && vitest run --config ../../vitest.standard.config.ts",
    "test:install": "node test/install.ts"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.8",
    "@mlc-ai/web-llm": "~0.2.86"
  },
  "devDependencies": {
    "@langchain/core": "1.3.6",
    "@langchain/langgraph": "^1.7.3",
    "@mlc-ai/web-llm": "0.2.88",
    "deepagents": "^1.16.3",
    "langchain": "^1.6.3",
    "playwright": "1.65.0",
    "zod": "^4.6.7"
  }
}
