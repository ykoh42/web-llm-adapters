{
  "name": "strands-webllm",
  "version": "0.0.0",
  "private": true,
  "description": "WebLLM model provider for Strands Agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/webllm-adapters.git",
    "directory": "packages/strands-webllm"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@strands-agents/sdk": "~1.21.0",
    "@mlc-ai/web-llm": "~0.2.86"
  },
  "devDependencies": {
    "@strands-agents/sdk": "1.21.0",
    "@mlc-ai/web-llm": "0.2.86"
  }
}
